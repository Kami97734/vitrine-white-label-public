# =======================================
# VARIÁVEIS DE AMBIENTE - PRODUÇÃO (Vercel)
# Copie para .env.local em desenvolvimento
# =======================================

# ── Banco de Dados (PostgreSQL - Neon/Supabase) ──
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# ── NextAuth ──
NEXTAUTH_URL="https://seu-site.vercel.app"
NEXTAUTH_SECRET="gere-um-secret-com-openssl-rand-base64-32"

# Google OAuth (opcional - https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Admin (JWT) ──
ADMIN_JWT_SECRET="gere-outro-secret-para-admin"

# Seed do primeiro admin (opcional, só usado em db:seed)
SEED_ADMIN_EMAIL="seu-email+admin@gmail.com"
SEED_ADMIN_PASSWORD="uma-senha-forte-aqui"

# ── SMTP para envio de código OTP ──
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="seu-email@gmail.com"
SMTP_PASS="sua-senha-de-app-gmail"
SMTP_FROM="Seu Site <seu-email@gmail.com>"

# ── Upload ──
# local = salva em public/uploads (apenas dev)
# cloudinary = usa Cloudinary (produção)
UPLOAD_PROVIDER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── IA (pelo menos um precisa estar configurado) ──
GROQ_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
MISTRAL_API_KEY=""
GOOGLE_API_KEY=""

# ── Rate Limit (memória = desliga rate-limit, útil p/ serverless) ──
RATE_LIMIT_MEMORY="true"
